projection;
strict ( 2 );
use draft;

define behavior for ZC_biblioteca_sdm alias Biblioteca
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Libros { create; with draft; }
}

define behavior for ZC_LIBRO_SDM alias Libro
{
  use update;
  use delete;

  use association _Biblioteca { with draft; }
}